        "services": [],
        "knowledgeBases": [],
        "output": {
          "fields": [
            {
              "name": "urgence",
              "type": "string"
            }
          ]
        }
      },
      {
        "kind": "condition",
        "name": "est_urgent",
        "if": {
          "ref": "tri.urgence",
          "operator": "egal",
          "value": "haute"
        },
        "then": [
          "traitement_urgent",
          "alerte_equipe"
        ],
        "else": [
          "accuse_reception"
        ]
      },
      {
        "kind": "agent",
        "name": "traitement_urgent",
        "instructions": "Vous traitez les e-mails urgents d'une PME.",
