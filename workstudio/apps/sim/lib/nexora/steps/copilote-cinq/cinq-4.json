{
  "description": "Rédiger le compte rendu d'une réunion, puis le faire valider avant envoi.",
  "plan": {
    "title": "Compte rendu de réunion validé",
    "trigger": {
      "kind": "manuel",
      "fields": [
        {
          "name": "notes_de_reunion",
          "description": "Notes ou transcription de la réunion"
        }
      ]
    },
    "steps": [
      {
        "kind": "agent",
        "name": "redaction_compte_rendu",
        "instructions": "Vous rédigez des comptes rendus de réunion pour une PME. Style clair, structuré et professionnel, en français.",
        "message": "Rédigez le compte rendu de la réunion suivante, avec les points clés, les décisions prises et les actions à mener : {{declencheur.notes_de_reunion}}",
        "services": [],
        "knowledgeBases": [],
        "output": {
          "fields": [
            {
              "name": "compte_rendu",
              "type": "string"
            }
          ]
        }
      },
      {
        "kind": "validation_humaine",
        "name": "validation_compte_rendu",
        "message": "Validez-vous ce compte rendu avant envoi ? Vous pouvez laisser un commentaire pour demander des modifications.\n\n{{redaction_compte_rendu.compte_rendu}}"
      },
      {
        "kind": "condition",
        "name": "est_approuve",
        "if": {
          "ref": "validation_compte_rendu.approuve",
          "operator": "egal",
          "value": "true"
        },
        "then": [
          "envoi_compte_rendu"
        ],
        "else": [
          "revision_compte_rendu"
        ]
      },
      {
        "kind": "agent",
        "name": "envoi_compte_rendu",
        "instructions": "Vous envoyez des comptes rendus de réunion aux participants, en les vouvoyant.",
        "message": "Envoyez ce compte rendu de réunion aux participants : {{redaction_compte_rendu.compte_rendu}}",
        "services": [],
        "knowledgeBases": []
      },
      {
        "kind": "agent",
        "name": "revision_compte_rendu",
        "instructions": "Vous intégrez les retours d'un validateur dans un compte rendu de réunion, en français et en vouvoyant.",
        "message": "Reprenez ce compte rendu en tenant compte du commentaire suivant : {{redaction_compte_rendu.compte_rendu}} — Commentaire : {{validation_compte_rendu.commentaire}}",
        "services": [],
        "knowledgeBases": []
      }
    ]
  },
