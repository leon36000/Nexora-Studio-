{
  "name": "simstudio-ts-sdk",
  "version": "0.2.1",
  "description": "SDK Nexora : exécuter les workflows d'une instance Nexora WorkStudio (non publié, à installer depuis le dépôt)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev:watch": "tsc --watch",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nexora",
    "ai",
    "workflow",
    "sdk",
    "api",
    "automation",
    "typescript"
  ],
  "author": "Nexora",
  "license": "Apache-2.0",
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leon36000/Nexora-Studio-.git",
    "directory": "workstudio/packages/ts-sdk"
  },
  "homepage": "https://github.com/leon36000/Nexora-Studio-/blob/main/docs/guide/api-developpeurs.md",
  "private": true
}
