# Nexora — configuration de la plateforme (docker compose -f deploy/compose.yml).
# Copiez ce fichier avec `scripts/init-env.sh` : il crée deploy/.env et remplace chaque « change-me »
# par un secret aléatoire. Ne commitez jamais deploy/.env.

# --- Images : construites ici (nexora/…:local) ou publiées (ex. ghcr.io/leon36000/nexora- et latest) ---
NEXORA_IMAGE_PREFIX=nexora/
NEXORA_VERSION=local

# --- Adresse publique de Nexora WorkStudio (telle que la saisissent vos utilisateurs) ---
NEXORA_PUBLIC_URL=http://localhost:3000
# Interface réseau sur laquelle publier WorkStudio (127.0.0.1 = cette machine seulement).
NEXORA_BIND_ADDRESS=127.0.0.1
# Interface des services internes (Nexora API, console Nexora Connect). Laissez 127.0.0.1.
NEXORA_SERVICES_BIND_ADDRESS=127.0.0.1
# Adresse publique de Nexora Connect, si ses connexions OAuth doivent revenir d'Internet.
NEXORA_CONNECT_PUBLIC_URL=
# HTTPS (profil « https », ajouté à COMPOSE_PROFILES par install.sh) : domaine public et certificat
# (une adresse e-mail pour Let's Encrypt, ou « internal » pour un certificat local).
NEXORA_DOMAIN=
NEXORA_TLS=internal
NEXORA_WORKSTUDIO_PORT=3000
NEXORA_REALTIME_PORT=3002
NEXORA_API_PORT=8000
NEXORA_CONNECT_PORT=8400
# Adresse publique du serveur temps réel (édition collaborative). Par défaut : http://localhost:<NEXORA_REALTIME_PORT>.
NEXORA_PUBLIC_REALTIME_URL=

# --- Modèle de langage servi par Nexora API ---
# Tout service compatible OpenAI (vLLM, Ollama, LiteLLM…) : adresse sans le suffixe /v1.
# Modèle local fourni avec Nexora (Ollama, toujours présent) : NEXORA_UPSTREAM_URL=http://ollama:11434.
# Profils facultatifs (ex. « search » pour la recherche web).
COMPOSE_PROFILES=
# Modèle d'embeddings des bases de connaissances, servi par l'Ollama de Nexora (1024 dimensions).
NEXORA_EMBED_MODEL=bge-m3
NEXORA_UPSTREAM_URL=http://host.docker.internal:11434
NEXORA_UPSTREAM_MODEL=qwen2.5:7b
NEXORA_UPSTREAM_KEY=none

# --- Votre organisation ---
# Chaque compte créé rejoint cette organisation comme membre : rôles, journal d'audit et consommation
# se gèrent au même endroit. Videz le nom pour laisser chacun fonder sa propre organisation.
NEXORA_ORGANIZATION_NAME=Mon entreprise
# Propriétaire de l'organisation (vous). FORTEMENT RECOMMANDÉ : sans cette adresse, le premier compte
# créé devient propriétaire.
NEXORA_ORGANIZATION_OWNER_EMAIL=

# --- Qui peut créer un compte ---
# Domaines e-mail autorisés, séparés par des virgules (ex. : mon-entreprise.fr). FORTEMENT RECOMMANDÉ :
# sans cette liste, toute personne qui atteint WorkStudio peut s'inscrire et utiliser les outils de Nexora Connect.
NEXORA_ALLOWED_EMAIL_DOMAINS=
# Fermez les inscriptions (true) une fois votre équipe inscrite.
NEXORA_REGISTRATION_DISABLED=false
# Exige la confirmation de l'adresse e-mail (nécessite un service d'e-mail, voir plus bas).
NEXORA_EMAIL_VERIFICATION=false

# --- Recherche web (SearXNG), désactivée par défaut ---
# Les requêtes partent vers des moteurs de recherche publics. Pour l'activer : NEXORA_WEB_SEARCH=1,
# NEXORA_SEARXNG_URL=http://searxng:8080, NEXORA_PREVIEW_BLOCKS=searxng et « search » dans
# COMPOSE_PROFILES (install.sh le fait).
NEXORA_WEB_SEARCH=0
NEXORA_SEARXNG_URL=
# Blocs révélés (« searxng » quand la recherche web est activée).
NEXORA_PREVIEW_BLOCKS=
NEXORA_SEARXNG_SECRET=change-me

# --- Langue et fuseau horaire par défaut de l'interface ---
NEXORA_TIME_ZONE=Europe/Paris

# --- Connexion unique (SSO OIDC, facultatif) : laissez vide pour la désactiver ---
# Une fois configurée, l'inscription par e-mail et mot de passe est fermée : les comptes se créent par le SSO.
NEXORA_OIDC_NAME=
NEXORA_OIDC_ISSUER=
NEXORA_OIDC_CLIENT_ID=
NEXORA_OIDC_CLIENT_SECRET=

# --- E-mails sortants (facultatif : invitations, vérification d'adresse, réinitialisation) ---
# Votre serveur SMTP (celui de votre messagerie ou d'un service d'envoi). Vide = pas d'e-mail :
# les invitations se font alors par lien à copier.
NEXORA_SMTP_HOST=
NEXORA_SMTP_PORT=
NEXORA_SMTP_USER=
NEXORA_SMTP_PASS=
# Adresse d'expédition (ex. nexora@mon-entreprise.fr).
NEXORA_EMAIL_FROM=
# Variante : clé du service Resend au lieu d'un serveur SMTP.
RESEND_API_KEY=

# --- Secrets (générés par scripts/init-env.sh) ---
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me
ENCRYPTION_KEY=change-me
INTERNAL_API_SECRET=change-me
API_ENCRYPTION_KEY=change-me
CRON_SECRET=change-me
NEXORA_API_SECRET_KEY=change-me
NEXORA_API_ADMIN_PASSWORD=change-me
NEXORA_API_REDIS_PASSWORD=change-me
NEXORA_CONNECT_ENCRYPTION_KEY=change-me
NEXORA_CONNECT_RUNTIME_TOKEN=change-me
NEXORA_CONNECT_ADMIN_TOKEN=change-me
