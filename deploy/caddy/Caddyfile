# Nexora — HTTPS en façade (profil compose « https »).
# NEXORA_DOMAIN : le domaine public ; NEXORA_TLS : une adresse e-mail (certificat Let's Encrypt,
# le domaine doit pointer vers ce serveur, ports 80 et 443 ouverts) ou « internal » (certificat
# local, à approuver sur les postes).

{$NEXORA_DOMAIN} {
	tls {$NEXORA_TLS}
	# API des développeurs, compatible OpenAI : https://<domaine>/v1 (WorkStudio la sert sous
	# /api/nexora/v1). Ni compression ni tampon : les réponses en flux arrivent mot à mot.
	@developer_api path /v1 /v1/*
	handle @developer_api {
		reverse_proxy workstudio:3000 {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		@realtime path /socket.io/*
		reverse_proxy @realtime workstudio-realtime:3002
		reverse_proxy workstudio:3000
	}
}

connect.{$NEXORA_DOMAIN} {
	tls {$NEXORA_TLS}
	reverse_proxy nexora-connect:3000
}

# Accès direct historique à Nexora API (ses propres clés, créées par curl). Les clés de
# Réglages › Clés API passent par https://<domaine>/v1 ci-dessus.
api.{$NEXORA_DOMAIN} {
	tls {$NEXORA_TLS}
	reverse_proxy nexora-api:8000
}
